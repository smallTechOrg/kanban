# ---------------------------------------------------------------------------
# Kan Ban -- repository ignore rules.
# Runtime state, build output and installed dependencies are never committed.
# ---------------------------------------------------------------------------

# Runtime state (database, uploads, backups, generated secret)
data/

# SQLite database files and their WAL sidecars, wherever they land
*.db
*.db-wal
*.db-shm

# Local environment overrides (.env.example is the committed template)
.env

# Build output
frontend/dist/

# Installed dependencies
node_modules/
.venv/

# Python caches and tooling
__pycache__/
*.py[cod]
backend/.pytest_cache/
.ruff_cache/

# setuptools metadata generated by the editable install
*.egg-info/

# Test and coverage artefacts
playwright-report/
test-results/
coverage/
.coverage
htmlcov/
.hypothesis/
# The throwaway data directory the Playwright run is pointed at (e2e/playwright.config.ts).
.tmp-verify/

# Editor and OS noise
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Documentation kept out of the repository.
# These are local working documents, not part of the shipped source. README.md
# stays tracked: it is the entry point a new clone needs to build and run.
# ---------------------------------------------------------------------------
docs/
CHANGELOG.md
CLAUDE.md
