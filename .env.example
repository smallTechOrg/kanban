# ---------------------------------------------------------------------------
# Kan Ban environment template (Section 1.9 of docs/PLANNING.md).
# Copy to .env in the repo root and edit; every value below is the default,
# so an empty .env behaves exactly like this file.
#   Windows PowerShell : Copy-Item .env.example .env
#   Linux / macOS bash : cp .env.example .env
# Relative paths resolve against the repo root, never the current directory.
# ---------------------------------------------------------------------------

KANBAN_ENV=prod              # set to dev for local work (CORS for :5173, dev-login, no dist check)
KANBAN_HOST=127.0.0.1        # loopback by default; 0.0.0.0 on a server behind a reverse proxy
KANBAN_PORT=8000             # bind port for uvicorn
KANBAN_DATA_DIR=./data       # root for the database, uploads and backups
KANBAN_DB_PATH=./data/kanban.db   # SQLite file path
KANBAN_SECRET=               # empty counts as unset = auto-generated into data/.secret on first run
KANBAN_HTTPS=0               # 1 sets the Secure flag on the kb_session cookie (use behind TLS)
KANBAN_SESSION_DAYS=30       # sliding session TTL in days
KANBAN_SINGLE_USER=0         # set to 1 for a one-person install (creates admin, prefills the login form)
KANBAN_ADMIN_PASSWORD=admin  # password for the bootstrapped admin user (only read when KANBAN_SINGLE_USER=1)
KANBAN_ALLOW_SIGNUP=1        # 0 returns 403 from POST /api/auth/register once at least one user exists
KANBAN_LOGIN_RATE_LIMIT=10/300    # attempts per seconds per IP on login and register
KANBAN_MAX_UPLOAD_MB=25      # attachment upload cap in MB (413 above it; backgrounds are capped at 10)
KANBAN_FRONTEND_DIST=./frontend/dist   # where the built SPA lives
KANBAN_LOG_LEVEL=info        # uvicorn/app log level
KANBAN_LOG_FORMAT=text       # text or json (one JSON object per line for log shippers)
KANBAN_SQL_ECHO=0            # 1 logs every SQL statement (sqlalchemy.engine at INFO)
